<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<!--
  证据台账 / 资料汇总处 组合筛选（AC-A5-1~A5-5、AC-B6-1/6-8）。

  注意：自定义 SQL 不经过 MyBatis-Plus 的逻辑删除改写，deleted = 0 必须显式写出，
  否则软删行会重新出现在列表里。
-->
<mapper namespace="com.hjgd.plm.ledger.mapper.PlmLedgerMapper">

  <select id="pageLedger" resultType="com.hjgd.plm.ledger.entity.PlmLedger">
    SELECT l.*
    FROM plm_ledger l
    <where>
      l.deleted = 0
      <if test="q.type != null and q.type != ''">
        AND l.type = #{q.type}
      </if>
      <!-- 精确定位单条(AC-B6-6 报告链接 → 汇总处该条); 行级范围与其余条件照旧生效 -->
      <if test="q.ledgerId != null">
        AND l.id = #{q.ledgerId}
      </if>
      <if test="q.ownerId != null">
        AND l.owner_id = #{q.ownerId}
      </if>
      <if test="q.deptId != null">
        AND l.dept_id = #{q.deptId}
      </if>
      <if test="q.status != null and q.status != ''">
        AND l.status = #{q.status}
      </if>
      <!-- 关键字命中 证据名称 / 证据编号 / 备注 任一（AC-A5-4） -->
      <if test="q.keyword != null and q.keyword != ''">
        AND (l.name LIKE CONCAT('%', #{q.keyword}, '%')
             OR l.ledger_no LIKE CONCAT('%', #{q.keyword}, '%')
             OR l.remark LIKE CONCAT('%', #{q.keyword}, '%'))
      </if>
      <!-- 来源证据编号（AC-B6-1） -->
      <if test="q.ledgerNoLike != null and q.ledgerNoLike != ''">
        AND l.ledger_no LIKE CONCAT('%', #{q.ledgerNoLike}, '%')
      </if>
      <!-- 时间范围按日闭合（AC-A5-3：起止同日可查；起 > 止 由服务层拦截） -->
      <if test="q.occurStart != null and q.occurStart != ''">
        AND l.occur_date &gt;= CAST(#{q.occurStart} AS DATE)
      </if>
      <if test="q.occurEnd != null and q.occurEnd != ''">
        AND l.occur_date &lt;= CAST(#{q.occurEnd} AS DATE)
      </if>
      <if test="q.uploadStart != null and q.uploadStart != ''">
        AND l.uploaded_at &gt;= CAST(#{q.uploadStart} AS DATE)
      </if>
      <if test="q.uploadEnd != null and q.uploadEnd != ''">
        AND l.uploaded_at &lt; (CAST(#{q.uploadEnd} AS DATE) + INTERVAL '1 day')
      </if>
      <!-- 变更时间范围（AC-B6-1） -->
      <if test="q.modifyStart != null and q.modifyStart != ''">
        AND l.last_modified_at &gt;= CAST(#{q.modifyStart} AS DATE)
      </if>
      <if test="q.modifyEnd != null and q.modifyEnd != ''">
        AND l.last_modified_at &lt; (CAST(#{q.modifyEnd} AS DATE) + INTERVAL '1 day')
      </if>
      <!--
        分类维度筛选（AC-B6-1）：每个维度一个 EXISTS，维度之间天然是「与」；
        同一维度内 value_id IN (...) 是「或」。一条资料在同一维度只存一个值
        （plm_ledger_category 唯一键 (ledger_id, dim_id)），故 IN 命中即该维度成立。
        只遍历 dims、空分组在 <if> 里跳过：collection 由 OGNL 求值，
        不写方法调用可以少一层「能不能求值」的不确定。
      -->
      <if test="q.categoryFilter != null and q.categoryFilter.dims != null">
        <foreach collection="q.categoryFilter.dims" item="g">
          <if test="g != null and g.dimId != null and g.valueIds != null and !g.valueIds.isEmpty()">
            AND EXISTS (SELECT 1 FROM plm_ledger_category lc
                        WHERE lc.ledger_id = l.id AND lc.deleted = 0
                          AND lc.dim_id = #{g.dimId}
                          AND lc.value_id IN
                          <foreach collection="g.valueIds" item="vid" open="(" separator="," close=")">
                            #{vid}
                          </foreach>)
          </if>
        </foreach>
      </if>
      <!-- 关联对象：命中引用表的编号/名称/业务键（AC-A5-1） -->
      <if test="q.objectType != null and q.objectType != ''">
        <if test="q.objectKeyword != null and q.objectKeyword != ''">
          AND EXISTS (SELECT 1 FROM plm_ledger_link k
                      WHERE k.ledger_id = l.id AND k.deleted = 0
                        AND k.object_type = #{q.objectType}
                        AND (k.object_no LIKE CONCAT('%', #{q.objectKeyword}, '%')
                             OR k.object_name LIKE CONCAT('%', #{q.objectKeyword}, '%')
                             OR k.object_id LIKE CONCAT('%', #{q.objectKeyword}, '%')))
        </if>
        <if test="q.objectKeyword == null or q.objectKeyword == ''">
          AND EXISTS (SELECT 1 FROM plm_ledger_link k
                      WHERE k.ledger_id = l.id AND k.deleted = 0
                        AND k.object_type = #{q.objectType})
        </if>
      </if>
      <!-- 行级范围：非台账管理员只能看到本部门或本人上传的证据（AC-A6 角色表） -->
      <if test="q.scopeDeptId != null">
        AND (l.dept_id = #{q.scopeDeptId} OR l.uploaded_by = #{q.scopeUserId})
      </if>
    </where>
    ORDER BY
    <choose>
      <when test="q.sortBy == 'name'">l.name</when>
      <when test="q.sortBy == 'occurDate'">l.occur_date</when>
      <when test="q.sortBy == 'uploadedAt'">l.uploaded_at</when>
      <when test="q.sortBy == 'status'">l.status</when>
      <otherwise>l.id</otherwise>
    </choose>
    <choose>
      <when test="q.sortOrder == 'asc'">ASC</when>
      <otherwise>DESC</otherwise>
    </choose>
  </select>

</mapper>
