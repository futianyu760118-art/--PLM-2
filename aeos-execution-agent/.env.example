# AEOS 执行面智能体配置示例（PLM 接入版；复制为 .env 使用；不要提交真实密钥）
# ===== Hub 控制通道（由 AEOS Hub 方提供） =====
EXECUTION_WS_URL=ws://HUB主机IP:8788/execution-agent
EXECUTION_PLANE_TOKEN=__REPLACE_WITH_AGENT_TOKEN__
EXECUTION_AGENT_ID=plm-execution-agent
EXECUTION_AGENT_NAME=恒剑PLM执行面智能体
EXECUTION_SOURCE_SYSTEM=恒剑PLM
EXECUTION_AGENT_VERSION=1.0.0
EXECUTION_PROTOCOL_VERSION=1.0

# ===== 目标系统查询接口（PLM 只读，JWT 登录鉴权） =====
# docker compose 部署（plm-network 内）用 http://backend:8080/api；
# 宿主机直跑（npm start）用 http://192.168.0.71/api 或 http://localhost:8081/api
TARGET_QUERY_BASE_URL=http://backend:8080/api
TARGET_QUERY_USERNAME=__REPLACE_WITH_READONLY_USERNAME__
TARGET_QUERY_PASSWORD=__REPLACE_WITH_READONLY_PASSWORD__
# HMAC 凭据（PLM 不使用，保留给其他目标系统）
TARGET_QUERY_APP_KEY=
TARGET_QUERY_APP_SECRET=

# ===== 目标系统推理智能体（契约确认后填写；留空则 reasoning 返回「未接通」） =====
TARGET_REASONING_URL=
TARGET_REASONING_AGENT_ID=
TARGET_REASONING_TOKEN=
